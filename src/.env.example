# =============================================================================
# D1 Mission Readiness & Predictive Maintenance Copilot — Environment Config
# =============================================================================
# Copy this file to .env and adjust values as needed.
# NEVER commit the real .env file with secrets to git.

# ── Application Environment ──────────────────────────────────────────────────
APP_PORT=8000
APP_ENV=development
DEBUG=True

# ── Database Connection ──────────────────────────────────────────────────────
# Default is async SQLite for instant local zero-config evaluation
DATABASE_URL=sqlite+aiosqlite:///./mission_readiness.db
# For production PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/mission_readiness

# ── Security & JWT Authentication ────────────────────────────────────────────
SECRET_KEY=d1-defense-military-readiness-secret-key-production-grade-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── IBM watsonx.ai Foundation Models (Optional / Dual-Mode) ───────────────────
# If provided, the system calls live IBM Granite 3-8B Instruct.
# If omitted, the built-in offline Granite inference engine handles all requests.
WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# ── IBM Bob / Model Context Protocol (MCP) ───────────────────────────────────
MCP_SERVER_NAME=mission-readiness-copilot
MCP_HOST=0.0.0.0
MCP_PORT=8000
